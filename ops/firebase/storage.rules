rules_version = '2';

// Stratos Ops — Storage rules for bucket stratos-ops-photos.
// Membership is stamped as a custom auth claim ("stratos": role) by the
// stratos-claims Cloud Function; cross-service firestore.exists() cannot read
// a NAMED Firestore database, so the claim is the gate.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null && request.auth.token.stratos != null;
    }
    match /jobs/{jobId}/{photo} {
      allow read: if isMember();
      allow write: if isMember()
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
